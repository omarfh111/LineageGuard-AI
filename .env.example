APP_ENV=
DATABASE_URL=

DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN=
DATAHUB_MUTATIONS_ENABLED=
TOOLS_IS_MUTATION_ENABLED=
DATAHUB_WRITEBACK_ENABLED=false

# Agentic RAG: Qdrant stores only a safe metadata projection. DataHub MCP
# remains the source of truth for live schemas and lineage.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=lineageguard_datahub
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Use local_hash together with DEMO_MODE=true to run the catalog experience
# without an OpenAI key. It is deterministic for demonstrations, not semantic.
RAG_EMBEDDING_PROVIDER=openai
DEMO_MODE=false
RAG_MAX_ASSETS=1500
OPENAI_CHAT_MODEL=gpt-4.1-mini

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CRITIC_MODEL=
NVIDIA_TIMEOUT_SECONDS=90

OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=

GROQ_API_KEY=
GROQ_JUDGE_MODEL=

JUDGE_TEMPERATURE=
JUDGE_TIMEOUT_SECONDS=
JUDGE_MAX_RETRIES=
# LangGraph/LangSmith tracing. It is opt-in and no secret is returned by the API.
# Legacy LANGCHAIN_* variables are also supported for an existing LangSmith project.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lineageguard-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=

VITE_API_BASE_URL=
