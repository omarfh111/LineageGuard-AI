APP_ENV=
DATABASE_URL=

DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN=
DATAHUB_MUTATIONS_ENABLED=
TOOLS_IS_MUTATION_ENABLED=
DATAHUB_WRITEBACK_ENABLED=false
# Pending external calls older than this become UNCERTAIN and require
# reconciliation instead of being retried automatically.
WRITEBACK_STALE_SECONDS=300

# Agentic RAG: Qdrant stores only a safe metadata projection. DataHub MCP
# remains the source of truth for live schemas and lineage.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=lineageguard_datahub
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Use local_hash together with DEMO_MODE=true to run the catalog experience
# without an OpenAI key. It is deterministic for demonstrations, not semantic.
RAG_EMBEDDING_PROVIDER=openai
DEMO_MODE=false
RAG_MAX_ASSETS=1500
# The 3D catalog starts loading when the API starts, not when a browser opens.
# It polls for catalog identity changes and refreshes immediately after an
# in-app DataHub action. Keep the bounds appropriate for local hardware.
CATALOG_AUTOLOAD=true
CATALOG_REFRESH_SECONDS=60
CATALOG_MAX_ASSETS=1500
CATALOG_MAX_EDGES=5000
CATALOG_LINEAGE_CONCURRENCY=8
# Every MCP session is bounded, and a catalog refresh has a separate watchdog.
DATAHUB_MCP_TIMEOUT_SECONDS=45
CATALOG_REFRESH_TIMEOUT_SECONDS=600
# Each scheduled poll inspects this rotating number of assets for schema and
# lineage changes in addition to checking the complete root catalog identity.
CATALOG_CHANGE_PROBE_ASSETS=25
# Conversation memory is local SQLite storage scoped to a browser-generated
# session ID. It is limited, expires automatically, and can be cleared in UI.
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_MAX_TURNS=6
CHAT_MEMORY_CONTEXT_CHARS=6000
CHAT_MEMORY_TTL_HOURS=168
OPENAI_CHAT_MODEL=gpt-4.1-mini
CHAT_TIMEOUT_SECONDS=15

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CRITIC_MODEL=
NVIDIA_TIMEOUT_SECONDS=90

OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=

GROQ_API_KEY=
GROQ_JUDGE_MODEL=

JUDGE_TEMPERATURE=
JUDGE_TIMEOUT_SECONDS=
JUDGE_MAX_RETRIES=
# LangGraph/LangSmith tracing. It is opt-in and no secret is returned by the API.
# Legacy LANGCHAIN_* variables are also supported for an existing LangSmith project.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lineageguard-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=

VITE_API_BASE_URL=
